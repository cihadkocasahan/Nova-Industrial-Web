# ─── Nova Industrial Web — Frontend Environment ──────────────────────────────
# Kopyala: cp .env.example .env  (frontend klasöründe)

# ── API ────────────────────────────────────────────────────────────────────
# Boş bırakılırsa Vite proxy üzerinden /api/v1 kullanılır (development)
# Production'da backend URL'ini belirtin:
# VITE_API_URL=https://api.nova-industrial.com/api/v1

# ── Demo Modu ─────────────────────────────────────────────────────────────
# UYARI: Sadece demo/staging ortamında true yapın. Production'da OLMAMALI!
# true olduğunda admin@nova-agro.demo / DemoAdmin2026! ile backend olmadan giriş yapılabilir.
VITE_ENABLE_DEMO=false
