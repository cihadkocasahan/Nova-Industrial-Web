{
  "name": "nova_industrial-backend",
  "version": "1.0.0",
  "description": "NOVA INDUSTRIAL Backend - Express + TypeScript + MySQL + Drizzle ORM",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.cjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.cjs",
    "db:studio": "drizzle-kit studio --config=drizzle.config.cjs",
    "db:seed": "tsx src/scripts/seed-all.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "migrate:projects-slug": "tsx src/scripts/migrate-projects-slug.ts",
    "migrate:add-slug-columns": "tsx src/scripts/add-slug-column.ts",
    "migrate:add-description-column": "tsx src/scripts/add-description-column.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "mysql",
    "drizzle",
    "api"
  ],
  "author": "NOVA INDUSTRIAL Team",
  "license": "MIT",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.26.0",
    "drizzle-orm": "^0.35.0",
    "express": "^5.0.1",
    "express-rate-limit": "^7.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^7.0.10",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
