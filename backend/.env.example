# ─── Nova Industrial Web — Backend Environment ───────────────────────────────
# Kopyala: cp .env.example .env  (backend klasöründe)

# ── Uygulama ────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production
APP_PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Veritabanı ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nova_industrial
DB_USER=root
DB_PASSWORD=your_db_password

# ── Güvenlik ─────────────────────────────────────────────────────────────────
# ZORUNLU: Bu değer olmadan sunucu başlamaz!
# Güvenli bir secret üretmek için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# Token süresi: 2h (production önerisi), 7d (development)
JWT_EXPIRES_IN=2h

# CORS: Production'da virgülle ayrılmış izin verilen origin'ler
# ZORUNLU production'da — tanımsızsa sunucu başlamaz!
# Örnek: CORS_ORIGIN=https://nova-industrial.com,https://www.nova-industrial.com
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── E-posta ──────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@nova-industrial.com
