{
  "name": "nova-industrial-web",
  "version": "1.0.0",
  "description": "NOVA INDUSTRIAL Web Application - Full Stack (Frontend + Backend)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "test": "node tests/e2e/runner.js",
    "test:tier1": "node tests/e2e/runner.js --tier=1",
    "test:tier2": "node tests/e2e/runner.js --tier=2",
    "test:tier3": "node tests/e2e/runner.js --tier=3",
    "test:tier4": "node tests/e2e/runner.js --tier=4",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "node backend/dist/server.js",
    "start:backend": "node backend/dist/server.js",
    "start:backend:npm": "cd backend && npm start",
    "preview:frontend": "cd frontend && npm run preview",
    "db:generate": "cd backend && npx drizzle-kit generate --config=drizzle.config.cjs",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:push": "cd backend && npx drizzle-kit push --config=drizzle.config.cjs",
    "db:studio": "cd backend && npx drizzle-kit studio --config=drizzle.config.cjs",
    "db:seed": "cd backend && npm run db:seed",
    "db:setup": "cd backend && npm run db:setup",
    "migrate:add-description-column": "cd backend && npm run migrate:add-description-column",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force -ErrorAction SilentlyContinue backend/node_modules, frontend/node_modules, backend/dist, frontend/dist\"",
    "clean:all": "npm run clean && powershell -Command \"Remove-Item -Recurse -Force -ErrorAction SilentlyContinue node_modules, package-lock.json\""
  },
  "keywords": [
    "nova_industrial",
    "react",
    "express",
    "typescript",
    "mysql",
    "drizzle",
    "vite",
    "fullstack"
  ],
  "author": "NOVA INDUSTRIAL Team",
  "license": "MIT",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.3",
    "axios": "^1.7.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.26.0",
    "drizzle-orm": "^0.35.0",
    "express": "^5.0.1",
    "express-rate-limit": "^7.2.0",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^7.0.10",
    "quill": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.2.3",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.23.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.9.2",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-swc": "^4.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "rollup-plugin-visualizer": "^6.0.5",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vite": "^5.2.11"
  }
}

